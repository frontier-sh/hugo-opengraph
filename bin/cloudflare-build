#!/bin/bash

# Build the Hugo site
echo "Building Hugo site with minification..."
hugo --gc --minify

# Install Node.js dependencies for OpenGraph image generator
echo "Setting up OpenGraph image generator..."
cd "$(dirname "$0")/../scripts/og-generator"

# Install dependencies if needed
if [ ! -d "node_modules" ] || [ ! -d "node_modules/canvas" ]; then
  echo "Installing dependencies..."
  npm install
else
  echo "Dependencies already installed."
fi

# Run the generator
echo "Generating OpenGraph images..."
node generate.js

# Return to the root directory
cd "$(dirname "$0")/.."

echo "Build completed successfully!"